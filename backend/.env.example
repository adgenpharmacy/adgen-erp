PORT=5000
NODE_ENV="development"

# --- Database (PostgreSQL / Supabase) ---
# Transaction-mode pooler connection (used by the app at runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_erp?schema=public"
# Session-mode / direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_erp?schema=public"

# --- Auth ---
# REQUIRED in production. Minimum 32 characters — the server refuses to boot without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- CORS ---
# Comma-separated list of allowed browser origins for the API.
# Leave empty in development to allow localhost. Set your real domain in production.
CORS_ORIGINS="http://localhost:3000"

# Path to service account json file if using service account, or firebase project id
FIREBASE_PROJECT_ID="adgen-pharmacy"
