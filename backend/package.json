{
  "name": "pharmacy-erp-backend",
  "version": "1.0.0",
  "description": "Enterprise Node.js TypeScript REST API Backend for Pharmacy ERP with PostgreSQL 3NF & Prisma ORM",
  "main": "dist/app.js",
  "scripts": {
    "build": "npx prisma generate && tsc",
    "vercel-build": "chmod +x node_modules/.bin/* 2>/dev/null || true; npx prisma generate && tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:owner": "ts-node src/scripts/seed-owner.ts",
    "db:check": "ts-node src/scripts/test-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.6.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "prisma": "^5.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
