datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Role {
  OWNER
  EMPLOYEE
}

enum ProductType {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  CREAM
  DROPS
  OINTMENT
  POWDER
  OTHERS
}

enum PartyType {
  SUPPLIER
  CUSTOMER
}

enum LedgerTransactionType {
  DEBIT
  CREDIT
}

/// Single-row table holding the pharmacy's own identity.
/// These values print on every tax invoice and GRN, so they must be editable by the owner
/// rather than hardcoded in the UI (they were, including a placeholder GSTIN).
model PharmacyProfile {
  id            String   @id @default("default")
  name          String   @default("AdGen Pharma")
  tagline       String?
  addressLine   String?
  city          String?
  state         String?
  pincode       String?
  phone         String?
  email         String?
  /// Printed on GST tax invoices — legally required to be the real GSTIN.
  gstNumber     String?
  /// Drug licence number, required on a pharmacy invoice in India.
  dlNumber      String?
  invoiceFooter String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("pharmacy_profile")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String?
  name         String
  role         Role          @default(EMPLOYEE)
  firebaseUid  String?
  designation  String?       @default("Pharmacist")
  isApproved   Boolean       @default(true)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  salesBills   SalesBill[]

  @@map("users")
}

model Product {
  id                  String               @id @default(uuid())
  name                String
  genericName         String?
  companyName         String?
  hsnCode             String?
  gstPercent          Float                @default(12)
  productType         ProductType          @default(TABLET)
  division            String?              @default("GENERAL")
  packSize            Int                  @default(1)
  packUnit            String?              @default("Strip")
  contentUnit         String?              @default("Tablet")
  requiresColdStorage Boolean              @default(false)
  lowStockThreshold   Float                @default(1)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  mrp                 Float?               @default(0)
  purchaseRate        Float?               @default(0)
  batches             InventoryBatch[]
  purchaseBillItems   PurchaseBillItem[]
  salesBillItems      SalesBillItem[]

  @@index([name])
  @@map("products")
}

model Party {
  id            String         @id @default(uuid())
  name          String
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  dlNumber      String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ledgerEntries LedgerEntry[]
  purchaseBills PurchaseBill[]

  @@map("parties")
}

model Customer {
  id            String        @id @default(uuid())
  name          String
  phone         String?
  email         String?
  address       String?
  doctorName    String?
  gstNumber     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  salesBills    SalesBill[]
  salesReturns  SalesReturn[]
  ledgerEntries LedgerEntry[]

  @@map("customers")
}

model InventoryBatch {
  id             String          @id @default(uuid())
  productId      String
  batchNumber    String
  expiryDate     DateTime
  quantity       Float           @default(0)
  mrp            Float
  purchaseRate   Float
  purchaseDate   DateTime        @default(now())
  purchaseBillId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseBill   PurchaseBill?   @relation(fields: [purchaseBillId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  salesBillItems SalesBillItem[]

  @@index([productId])
  @@index([batchNumber])
  @@map("inventory_batches")
}

model PurchaseBill {
  id              String             @id @default(uuid())
  invoiceNumber   String
  partyId         String
  purchaseDate    DateTime           @default(now())
  subtotal        Float
  taxTotal        Float
  /// Bill-level (scheme) discount from the supplier, on top of per-item discounts.
  discount        Float              @default(0)
  grandTotal      Float
  amountPaid      Float              @default(0)
  isPaid          Boolean            @default(false)
  /// Mirrors SalesBill: whether the grand total was rounded to the nearest rupee.
  isRoundOff      Boolean            @default(true)
  roundOffAmount  Float              @default(0)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  batches         InventoryBatch[]
  ledgerEntries   LedgerEntry[]
  party           Party              @relation(fields: [partyId], references: [id])
  items           PurchaseBillItem[]
  purchaseReturns PurchaseReturn[]

  @@index([createdAt])
  @@map("purchase_bills")
}

model PurchaseBillItem {
  id              String       @id @default(uuid())
  purchaseBillId  String
  productId       String
  batchNumber     String
  expiryDate      DateTime
  quantity        Float
  freeQuantity    Float        @default(0)
  purchaseRate    Float
  mrp             Float
  taxPercent      Float        @default(0)
  discountPercent Float        @default(0)
  totalAmount     Float
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  product         Product      @relation(fields: [productId], references: [id])
  purchaseBill    PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)

  @@map("purchase_bill_items")
}

model SalesBill {
  id             String          @id @default(uuid())
  invoiceNumber  String?
  customerId     String?
  customerName   String?         @default("Walk-in Customer")
  customerPhone  String?
  doctorName     String?
  notes          String?
  userId         String?
  subtotal       Float           @default(0)
  taxTotal       Float           @default(0)
  discount       Float           @default(0)
  grandTotal     Float
  amountPaid     Float           @default(0)
  cashAmount     Float           @default(0)
  upiAmount      Float           @default(0)
  cardAmount     Float           @default(0)
  creditAmount   Float           @default(0)
  paymentMethod  String          @default("CASH")
  isPaid         Boolean         @default(true)
  isSettled      Boolean         @default(true)
  isRoundOff     Boolean         @default(true)
  roundOffAmount Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ledgerEntries  LedgerEntry[]
  customer       Customer?       @relation(fields: [customerId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  items          SalesBillItem[]
  salesReturns   SalesReturn[]

  @@index([createdAt])
  @@map("sales_bills")
}

model SalesBillItem {
  id              String         @id @default(uuid())
  salesBillId     String
  productId       String
  batchId         String
  quantity        Float
  unitPrice       Float
  taxPercent      Float          @default(0)
  discountPercent Float          @default(0)
  totalAmount     Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  batch           InventoryBatch @relation(fields: [batchId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  salesBill       SalesBill      @relation(fields: [salesBillId], references: [id], onDelete: Cascade)

  @@map("sales_bill_items")
}

model LedgerEntry {
  id              String                @id @default(uuid())
  partyType       PartyType
  partyId         String?
  customerId      String?
  transactionType LedgerTransactionType
  amount          Float
  paymentMethod   String?
  purchaseBillId  String?
  salesBillId     String?
  description     String?
  isSettled       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  party           Party?                @relation(fields: [partyId], references: [id])
  customer        Customer?             @relation(fields: [customerId], references: [id])
  purchaseBill    PurchaseBill?         @relation(fields: [purchaseBillId], references: [id])
  salesBill       SalesBill?            @relation(fields: [salesBillId], references: [id])

  @@index([partyId])
  @@index([customerId])
  @@map("ledger_entries")
}

model SalesReturn {
  id                String            @id @default(uuid())
  returnNumber      String
  salesBillId       String?
  customerId        String?
  totalReturnAmount Float
  refundMethod      String            @default("CASH")
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  salesBill         SalesBill?        @relation(fields: [salesBillId], references: [id], onDelete: Cascade)
  customer          Customer?         @relation(fields: [customerId], references: [id])
  items             SalesReturnItem[]

  @@map("sales_returns")
}

model SalesReturnItem {
  id            String      @id @default(uuid())
  salesReturnId String
  productId     String
  batchNumber   String?
  quantity      Float
  unitPrice     Float
  totalAmount   Float
  condition     String      @default("RESTOCK") // RESTOCK or DAMAGED
  reason        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  @@map("sales_return_items")
}

model PurchaseReturn {
  id                String               @id @default(uuid())
  returnNumber      String
  purchaseBillId    String?
  partyId           String?
  totalReturnAmount Float
  refundMethod      String               @default("DEBIT_NOTE")
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  purchaseBill      PurchaseBill?        @relation(fields: [purchaseBillId], references: [id])
  items             PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String         @id @default(uuid())
  purchaseReturnId String
  productId        String
  batchNumber      String?
  quantity         Float
  purchaseRate     Float
  totalAmount      Float
  reason           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@map("purchase_return_items")
}

